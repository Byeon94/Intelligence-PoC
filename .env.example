# 공공데이터포털(data.go.kr) 금융위원회 서비스 공용 인증키.
# - "금융위원회_금융투자협회종합통계정보" 활용신청 후 발급 (증시자금·CMA·신용공여)
# - "금융위원회_지수시세정보" 활용신청 (같은 계정/같은 키로 거래대금 조회)
# 발급 즉시 자동승인. 인코딩/디코딩 키 아무거나 넣어도 됩니다.
DATA_GO_KR_API_KEY=your_data_go_kr_service_key

# Google AI Studio (Gemini) API 키 — 정책/규제 탭의 AI 브리핑 생성에 사용.
# 무료 티어는 하루 호출 수 제한이 있으므로 브리핑은 하루 1회만 생성하고 캐시합니다.
# GEMINI_API_KEY 부터 _5 까지 순서대로 읽어 429 시 다음 키로 폴백합니다(중복값은 무시).
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_2=optional_backup_gemini_api_key
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# 선택: 하루 AI 브리핑 생성 재시도 상한(429 시 백업 키 재시도 포함). 기본 3.
POLICY_MAX_GEMINI_CALLS_PER_DAY=3

# 네이버 검색 API — 리서치·뉴스 탭(기사 수집), 여신·심사 기업분석(업종·PER·PBR 참고용).
# https://developers.naver.com 에서 애플리케이션 등록 후 발급.
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# 금융감독원 DART OpenAPI — 자본시장 > 발행시장(유상증자 공시), 여신·심사 기업분석
# (기업개황·재무제표·공시목록). https://opendart.fss.or.kr 에서 발급.
DART_API_KEY=your_dart_api_key

# Supabase — 정책/규제 탭 일일 스냅샷 저장(스크랩은 하루 1회, 결과를 DB에 보관).
# 비워두면 프로세스 메모리에만 임시 저장됩니다(재시작 시 그날 다시 스크랩).
# schema.sql 의 policy_snapshots 테이블을 먼저 생성하세요.
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_or_anon_key

# 선택: /internal/warmup 호출 인증용 비밀키(직접 생성한 임의 문자열).
# 매일 00:01 KST에 GitHub Actions(.github/workflows/warmup.yml)가 이 키로 정책·규제/
# 리서치·뉴스/발행시장/CMA 금리 스냅샷을 미리 만들어, 첫 방문자가 느린 최초 로딩을
# 겪지 않게 한다. 비워두면 /internal/warmup 은 항상 403을 반환(비활성화).
WARMUP_KEY=

# 선택: 키가 없어도 화면은 동작하며, 자본시장 지표는 샘플 데이터로 대체됩니다.
