# 공공데이터포털(data.go.kr) 금융위원회 서비스 공용 인증키.
# - "금융위원회_금융투자협회종합통계정보" 활용신청 후 발급 (증시자금·CMA·신용공여)
# - "금융위원회_지수시세정보" 활용신청 (같은 계정/같은 키로 거래대금 조회)
# 발급 즉시 자동승인. 인코딩/디코딩 키 아무거나 넣어도 됩니다.
DATA_GO_KR_API_KEY=your_data_go_kr_service_key

# Google AI Studio (Gemini) API 키 — 각 탭 AI 브리핑·뉴스 선별·리드 판단에 사용.
# 키는 이것 하나만 읽습니다. 비워두면 AI 가공 없이 원자료만 보여줍니다.
# AI 결과는 일일 스냅샷에 저장돼 하루 1회만 생성됩니다(매일 00:01 KST 예열).
GEMINI_API_KEY=your_gemini_api_key

# 선택: Gemini 모델명. 기본 gemini-3.6-flash.
GEMINI_MODEL=

# 선택: 앱 전체(모든 탭 합산) 하루 Gemini 실호출 상한 — 비용 통제용. 기본 30, 0이면 무제한.
# (수동 실행하는 업종 분류 배치는 이 상한에서 제외)
GEMINI_MAX_CALLS_PER_DAY=40

# 선택: 이름과 달리 "스냅샷 1건당 AI 재시도 상한"(정책·뉴스·IT뉴스·발행시장·여신 뉴스 등
# 모든 탭 공통). 기본 3. Render 설정 호환을 위해 예전 이름을 유지합니다.
POLICY_MAX_GEMINI_CALLS_PER_DAY=3

# 네이버 검색 API — 뉴스·IT뉴스·증권대차·여신 뉴스 동향(기사 수집), 기업분석 참고 지표.
# https://developers.naver.com 에서 애플리케이션 등록 후 발급.
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# 금융감독원 DART OpenAPI — 자본시장 > 발행시장(유상증자 공시), 여신 리드 레이더(지분 공시),
# 기업분석(기업개황·재무제표·공시목록). https://opendart.fss.or.kr 에서 발급.
DART_API_KEY=your_dart_api_key

# 한국은행 ECOS Open API — 단기자금 탭(원화 시장금리·기준금리, 외화 환율·주요국 정책금리)
# 발급: https://ecos.bok.or.kr → Open API → 인증키 신청
ECOS_API_KEY=your_ecos_api_key

# Supabase — 모든 탭 일일 스냅샷 저장(스크랩·AI 가공은 하루 1회, 결과를 DB에 보관).
# 비워두면 프로세스 메모리에만 임시 저장됩니다(재시작 시 그날 다시 스크랩).
# schema.sql 을 Supabase SQL 편집기에서 먼저 실행하세요.
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_or_anon_key

# 선택: /internal/warmup 호출 인증용 비밀키(직접 생성한 임의 문자열).
# 매일 00:01 KST에 GitHub Actions(.github/workflows/warmup.yml)가 이 키로 각 탭의 그날
# 스냅샷(작업 목록은 main/app.py _WARMUP_JOBS)을 미리 만들어, 첫 방문자가 느린 최초
# 로딩을 겪지 않게 한다. 비워두면 /internal/warmup 은 항상 403을 반환(비활성화).
WARMUP_KEY=

# 선택: 키가 없어도 화면은 동작하며, 자본시장 지표는 샘플 데이터로 대체됩니다.
